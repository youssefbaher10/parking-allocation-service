# Application configuration
PORT=3001
RATE_LIMIT=120
FRONTEND_ORIGIN=

# AWS / Floci configuration
AWS_REGION=us-east-1
AWS_PROFILE=floci
DYNAMODB_ENDPOINT=http://localhost:4566

# DynamoDB tables
PARKING_REQUESTS_TABLE=ParkingRequests
RESERVATIONS_TABLE=Reservations
WAITLIST_TABLE=ParkingWaitlist
PRICING_TABLE=PricingRules

# Inventory integration
INVENTORY_MODE=sample
INVENTORY_URL=
INVENTORY_TOKEN=
CONTAINER_INVENTORY_URL=

# Internal microservice authentication
INTERNAL_TOKEN=

# Cognito authentication
AUTH_MODE=cognito
COGNITO_REGION=us-east-1
COGNITO_ENDPOINT=http://localhost:4566
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_ISSUER=
COGNITO_JWKS_URL=
COGNITO_USERS_FILE=.local/cognito-users.json

# Lambda configuration
LAMBDA_DYNAMODB_ENDPOINT=http://host.docker.internal:4566